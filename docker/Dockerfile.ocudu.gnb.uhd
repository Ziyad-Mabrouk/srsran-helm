ARG OS_VERSION=24.04
ARG UHD_VERSION=4.9.0.1
ARG ROHC_VERSION=2.3.1
ARG OCUDU_VERSION=release_26_04

FROM ubuntu:${OS_VERSION} AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    cmake \
    pkg-config \
    autoconf \
    automake \
    autotools-dev \
    libtool \
    libpcap-dev \
    libcmocka-dev \
    libfftw3-dev \
    libmbedtls-dev \
    libsctp-dev \
    libyaml-cpp-dev \
    libgtest-dev \
    libboost-all-dev \
    libusb-1.0-0-dev \
    python3-mako \
    python3-numpy \
    python3-setuptools \
    python3-requests \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG ROHC_VERSION

RUN curl -fsSL \
    "https://rohc-lib.org/download/rohc-${ROHC_VERSION%.*}.x/${ROHC_VERSION}/rohc-${ROHC_VERSION}.tar.xz" \
    -o /tmp/rohc.tar.xz \
    && tar -xf /tmp/rohc.tar.xz -C /tmp \
    && cd "/tmp/rohc-${ROHC_VERSION}" \
    && ./autogen.sh \
    && ./configure --prefix=/opt/rohc \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf /tmp/rohc-* \
    && ldconfig

ARG UHD_VERSION

RUN curl -fsSL \
    "https://github.com/EttusResearch/uhd/archive/refs/tags/v${UHD_VERSION}.tar.gz" \
    | tar -xzf - -C /tmp \
    && cd "/tmp/uhd-${UHD_VERSION}/host" \
    && cmake -S . -B build \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/opt/uhd/${UHD_VERSION} \
        -DENABLE_LIBUHD=On \
        -DENABLE_PYTHON_API=Off \
        -DENABLE_EXAMPLES=Off \
        -DENABLE_TESTS=Off \
        -DBoost_NO_BOOST_CMAKE=ON \
        -DCMAKE_CXX_FLAGS="-march=native" \
    && cmake --build build -- -j"$(nproc)" \
    && cmake --install build \
    && rm -rf "/tmp/uhd-${UHD_VERSION}"

ARG OCUDU_VERSION

RUN git clone --depth 1 --branch "${OCUDU_VERSION}" \
    https://gitlab.com/ocudu/ocudu.git /src

WORKDIR /src

ARG UHD_VERSION

ENV ROHC_DIR=/opt/rohc
ENV UHD_DIR=/opt/uhd/${UHD_VERSION}

RUN cmake -S . -B build \
    -DBUILD_TESTING=OFF \
    -DENABLE_UHD=On \
    -DENABLE_DPDK=Off \
    -DCMAKE_INSTALL_PREFIX=/opt/ocudu \
    && cmake --build build --target gnb -- -j"$(nproc)" \
    && mkdir -p /opt/ocudu/bin \
    && cp build/apps/gnb/gnb /opt/ocudu/bin/gnb

FROM ubuntu:${OS_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

ARG UHD_VERSION

ENV LD_LIBRARY_PATH=/opt/rohc/lib:/opt/rohc/lib64:/opt/uhd/${UHD_VERSION}/lib:/opt/uhd/${UHD_VERSION}/lib64:/opt/uhd/${UHD_VERSION}/lib/x86_64-linux-gnu:/opt/uhd/${UHD_VERSION}/lib/aarch64-linux-gnu
ENV PATH=/opt/uhd/${UHD_VERSION}/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    libfftw3-dev \
    libmbedtls-dev \
    libsctp-dev \
    libyaml-cpp-dev \
    libgtest-dev \
    libcap2-bin \
    libboost-all-dev \
    libusb-1.0-0 \
    libusb-1.0-0-dev \
    libusb-dev \
    python3-dev \
    python3-requests \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/rohc /opt/rohc
COPY --from=builder /opt/uhd/${UHD_VERSION} /opt/uhd/${UHD_VERSION}
COPY --from=builder /opt/ocudu/bin/gnb /usr/local/bin/gnb

RUN printf '%s\n' \
    /opt/rohc/lib \
    /opt/rohc/lib64 \
    /opt/uhd/${UHD_VERSION}/lib \
    /opt/uhd/${UHD_VERSION}/lib64 \
    /opt/uhd/${UHD_VERSION}/lib/x86_64-linux-gnu \
    /opt/uhd/${UHD_VERSION}/lib/aarch64-linux-gnu \
    > /etc/ld.so.conf.d/ocudu.conf \
    && ldconfig \
    && uhd_images_downloader \
    && setcap cap_sys_nice,cap_ipc_lock,cap_perfmon+ep /usr/local/bin/gnb

ENTRYPOINT ["/usr/local/bin/gnb"]